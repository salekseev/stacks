{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/stacks/.+\\.ya?ml$/"
    ]
  },
  "schedule": [
    "before 4am on Monday"
  ],
  "assignees": [
    "@salekseev"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "nod image tags in stacks/nod.yaml are the upstream version; .github/workflows/nod-images.yml builds them from release tag nod-v<version>",
      "managerFilePatterns": ["/^stacks/nod\\.yaml$/"],
      "matchStrings": ["image: ghcr\\.io/salekseev/nod-[a-z]+:(?<currentValue>\\S+)"],
      "depNameTemplate": "n8n-io/nod",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^nod-v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "v3rt3p images are pinned to their submodule SHA and rebuilt by CI; bumps come from submodule updates (same commit), not docker tag lookups",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/salekseev/v3rt3p-{/,}**"],
      "enabled": false
    },
    {
      "description": "nod images are built by CI from upstream releases; bumps come from the n8n-io/nod custom manager above, not docker tag lookups (a tag exists only after the bump is merged)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/salekseev/nod-{/,}**"],
      "enabled": false
    },
    {
      "description": "our codex-lb image is the upstream release plus a patch (stacks/codex-lb/Dockerfile) and is rebuilt by CI; upstream bumps arrive through the FROM line there, not docker tag lookups",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/salekseev/codex-lb"],
      "enabled": false
    },
    {
      "description": "Pin digests for rolling tags to track underlying image changes",
      "matchDatasources": [
        "docker"
      ],
      "matchCurrentValue": "/^(latest|plexpass|nvidia)$/i",
      "pinDigests": true
    },
    {
      "description": "Parse version from hotio images and preserve release- prefix",
      "matchDatasources": [
        "docker"
      ],
      "versionCompatibility": "^release-v?(?<version>.*)$",
      "matchPackageNames": [
        "ghcr.io/hotio/{/,}**"
      ]
    },
    {
      "description": "Extract version from text-embeddings-inference tags (compute-capability-version format, e.g. 86-1.9)",
      "matchDatasources": [
        "docker"
      ],
      "versionCompatibility": "^\\d+-(?<version>.*)$",
      "matchPackageNames": [
        "ghcr.io/huggingface/text-embeddings-inference"
      ]
    },
    {
      "description": "Group minor updates together",
      "matchDatasources": [
        "docker",
        "github-tags"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "Minor updates"
    },
    {
      "description": "Automerge patch updates",
      "matchDatasources": [
        "docker",
        "github-tags"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "labels": [
        "dependencies",
        "renovate",
        "automerge"
      ]
    },
    {
      "description": "Major updates get their own PRs for review",
      "matchDatasources": [
        "docker",
        "github-tags"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null
    }
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "prConcurrentLimit": 5
}
