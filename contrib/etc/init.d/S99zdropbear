#!/bin/sh
DB=/data/opt/bin/dropbear
HK=/data/opt/etc/dropbear/hk_ed25519
AK=/data/opt/etc/dropbear/authorized_keys
mkdir -p $(dirname "$HK") /root/.ssh
chmod 700 /root/.ssh
[ -f "$HK" ] || "$DB"key -t ed25519 -f "$HK"
if [ -s "$AK" ]; then
  cp "$AK" /root/.ssh/authorized_keys
  chmod 600 /root/.ssh/authorized_keys
fi
exec "$DB" -r "$HK" -p 2222 -s
